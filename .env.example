# Copy this file to .env and fill in real values.
# If SMTP_HOST is left empty, the server runs in DEMO mode: mails go to a
# temporary Ethereal inbox and preview links are printed in the console.

PORT=3000

# SMTP account used to send mails (Gmail: smtp.gmail.com / 465 / App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# "From" shown to recipients
MAIL_FROM_NAME=Sri Peddammathalli Creations
MAIL_FROM_ADDRESS=

# Admin inbox(es) that receive every enquiry (comma-separated for several)
ADMIN_EMAIL=harishdirector62@gmail.com,gsrinath053@gmail.com
